[Unit]
Description=Blackbox scheduler trace collector
Documentation=https://github.com/blackbox-rs/blackbox
After=local-fs.target

[Service]
Type=simple
# Foreground: the daemon must not fork itself, so systemd can supervise it.
# /run/blackbox (created by RuntimeDirectory) is where the control socket and
# PID file go, and it is only writable because systemd makes it so.
ExecStart=/usr/local/bin/blackboxd --config /etc/blackbox/config.toml
RuntimeDirectory=blackbox
Restart=on-failure
RestartSec=1

# BPF loading needs CAP_BPF/CAP_PERFMON (or root); PSI reads need nothing.
# Drop privileges here once your deployment's capability set is worked out.
User=root
Group=root
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
